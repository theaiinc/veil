{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "veil-regex",
  "sourceRoot": "packages/veil-regex/src",
  "projectType": "library",
  "implicitDependencies": ["veil"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "tsup", "cwd": "packages/veil-regex" },
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run", "cwd": "packages/veil-regex" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p tsconfig.json", "cwd": "packages/veil-regex" }
    }
  }
}
